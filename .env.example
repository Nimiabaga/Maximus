# Copy to .env.local for `vercel dev`. In Vercel dashboard, set these under
# Project Settings -> Environment Variables (Production + Preview).

# One-time: pick a passcode, then compute its hash and paste the result here.
# Node: node -e "console.log(require('crypto').scryptSync(process.argv[1], 'maximus-menu-salt', 64).toString('hex'))" "YOUR-PASSCODE"
ADMIN_PASSCODE_HASH=

# Random secret used to sign admin session cookies.
# Node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Added automatically when you connect the Upstash (Redis) integration from
# the Vercel Marketplace to this project (Project -> Integrations). Check the
# exact names Vercel injects after connecting -- it may use the KV_REST_API_*
# names or the UPSTASH_REDIS_REST_* names depending on integration version.
# Both are read by lib/redis.js, so either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
